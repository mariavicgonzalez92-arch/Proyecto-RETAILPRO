-- ----------------------------------------------------------------------------
-- PASO 1: Creación de la Base de Datos (Omitir si el entorno web la auto-genera)
-- ----------------------------------------------------------------------------
CREATE DATABASE Ventas_Tech_DB;
GO 
USE Ventas_Tech_DB;
GO

-- ----------------------------------------------------------------------------
-- SECCIÓN DDL: ELIMINACIÓN DE TABLAS (Orden inverso de dependencias)
-- Eliminamos primero las tablas con dependencias (FK) para evitar bloqueos.
-- ----------------------------------------------------------------------------
DROP TABLE IF EXISTS ventas;
DROP TABLE IF EXISTS productos;
DROP TABLE IF EXISTS clientes;
DROP TABLE IF EXISTS categorias;

-- ----------------------------------------------------------------------------
-- SECCIÓN DDL: CREACIÓN DE TABLAS Y CONSTRAINTS (Modelo en Estrella - 3NF)
-- ----------------------------------------------------------------------------

-- 1. Tabla de Categorías (Dimensión sin dependencias)
CREATE TABLE categorias (
    id_categoria INT PRIMARY KEY,
    nombre_categoria VARCHAR(50) NOT NULL,
    descripcion VARCHAR(200)
);

-- 2. Tabla de Clientes (Dimensión sin dependencias, con constraint UNIQUE en email)
CREATE TABLE clientes (
    id_cliente INT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    ciudad VARCHAR(50),
    fecha_registro DATE NOT NULL
);

-- 3. Tabla de Productos (Dimensión con FK apuntando a categorias)
CREATE TABLE productos (
    id_producto INT PRIMARY KEY,
    nombre_producto VARCHAR(100) NOT NULL,
    id_categoria INT NOT NULL,
    -- precio: DECIMAL(10,2) para evitar imprecisiones de coma flotante (FLOAT) en moneda
    precio DECIMAL(10,2) NOT NULL,
    stock INT DEFAULT 0,
    activo TINYINT DEFAULT 1,
    
    -- Restricción de Integridad Referencial
    FOREIGN KEY (id_categoria) REFERENCES categorias(id_categoria)
);

-- 4. Tabla de Ventas (Tabla de Hechos Central con múltiples FK)
CREATE TABLE ventas (
    id_venta INT PRIMARY KEY,
    id_cliente INT NOT NULL,
    id_producto INT NOT NULL,
    cantidad INT NOT NULL,
    precio_unitario DECIMAL(10,2) NOT NULL,
    fecha_venta DATE NOT NULL,
    
    -- Restricciones de Integridad Referencial
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente),
    FOREIGN KEY (id_producto) REFERENCES productos(id_producto)
);

